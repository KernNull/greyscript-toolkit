// PING-SCOUT 0.5 — Read-Only Network Reconnaissance Utility
// Usage: ping-scout [optional_target_ip]

if params.len > 0 then
    if params[0] == "-h" or params[0] == "--help" then
        print("Usage: ping-scout [target_ip]")
        print("  No args  : Scout local system, router, and LAN.")
        print("  target_ip: Scout remote router, forwarded ports, firewall, and LAN.")
        exit("")
    end if
end if

print("========================================")
print("          PING-SCOUT 0.5")
print("       NETWORK RECONNAISSANCE")
print("========================================")
print("")

shell = get_shell
if not shell then exit("Error: Could not obtain local shell.")
computer = shell.host_computer
if not computer then exit("Error: Could not obtain host computer.")

targetIp = ""
isRemote = 0
if params.len > 0 then
    targetIp = params[0]
    isRemote = 1
    router = get_router(targetIp)
    if not router then exit("Error: Could not reach router for " + targetIp)
else
    router = get_router
    if not router then exit("Error: Could not obtain local router.")
end if

localPortCount = 0
deviceCount = 0
openPortCount = 0
closedPortCount = 0
devicesWithPorts = 0
devicesWithoutPorts = 0
unavailablePortScans = 0

identifiedServiceCount = 0
unavailableServiceCount = 0

httpCount = 0
ftpCount = 0
sshCount = 0
otherServiceCount = 0

if isRemote == 0 then
    print("[ LOCAL SYSTEM ]")
    print("Hostname: " + computer.get_name)
    print("Local IP: " + computer.local_ip)
    print("Public IP: " + computer.public_ip)
    print("Gateway: " + computer.network_gateway)
    print("Network Card: " + computer.active_net_card)
    print("Internet Status: " + computer.is_network_active)
    print("")

    localPorts = computer.get_ports
    if typeof(localPorts) == "list" then
        localPortCount = localPorts.len
    end if
    print("Active Local Ports: " + localPortCount)
    print("")
else
    print("[ TARGET MODE ]")
    print("Target IP: " + targetIp)
    print("")
end if

print("[ ROUTER INFORMATION ]")
print("Router Local IP: " + router.local_ip)
print("Router Public IP: " + router.public_ip)
print("Kernel Version: " + router.kernel_version)

essid = router.essid_name
bssid = router.bssid_name
if typeof(essid) == "string" and essid.len > 0 then
    print("ESSID: " + essid)
end if
if typeof(bssid) == "string" and bssid.len > 0 then
    print("BSSID: " + bssid)
end if
print("")

print("[ ROUTER FORWARDED PORTS ]")
usedPorts = router.used_ports
if typeof(usedPorts) == "list" then
    if usedPorts.len == 0 then
        print("No forwarded/used ports reported.")
    else
        for uPort in usedPorts
            uNum = uPort.port_number
            uState = "OPEN"
            if uPort.is_closed then uState = "CLOSED"
            uLan = uPort.get_lan_ip
            uInfo = router.port_info(uPort)
            if typeof(uInfo) != "string" then uInfo = "Unavailable"
            print("  " + uNum + " [" + uState + "] -> " + uLan + " | " + uInfo)
        end for
    end if
else
    print("Forwarded port list: Unavailable")
end if
print("")

print("[ FIREWALL RULES ]")
fwRules = router.firewall_rules
if typeof(fwRules) == "list" then
    if fwRules.len == 0 then
        print("No firewall rules configured.")
    else
        for rule in fwRules
            print("  " + rule)
        end for
    end if
else
    print("Firewall rules: Unavailable")
end if
print("")

devices = router.devices_lan_ip
if typeof(devices) != "list" then
    print("[ LAN DEVICE INVENTORY ]")
    print("LAN device list: Unavailable")
    devices = []
else
    deviceCount = devices.len
    print("[ LAN DEVICE INVENTORY ]")
    print("Devices Discovered: " + deviceCount)
end if
print("")

for ip in devices
    print("----------------------------------------")
    print("DEVICE: " + ip)

    ports = router.device_ports(ip)
    if typeof(ports) == "list" then
        if ports.len > 0 then
            devicesWithPorts = devicesWithPorts + 1
            print("Ports Reported: " + ports.len)

            for port in ports
                portNumber = port.port_number
                portState = "OPEN"
                if port.is_closed then
                    portState = "CLOSED"
                    closedPortCount = closedPortCount + 1
                else
                    openPortCount = openPortCount + 1
                end if

                serviceInfo = router.port_info(port)
                if typeof(serviceInfo) == "string" then
                    identifiedServiceCount = identifiedServiceCount + 1
                    print("  " + portNumber + " [" + portState + "] -> " + serviceInfo)

                    serviceLower = serviceInfo.lower
                    if serviceLower.indexOf("http") >= 0 then
                        httpCount = httpCount + 1
                    else if serviceLower.indexOf("ftp") >= 0 then
                        ftpCount = ftpCount + 1
                    else if serviceLower.indexOf("ssh") >= 0 then
                        sshCount = sshCount + 1
                    else
                        otherServiceCount = otherServiceCount + 1
                    end if
                else
                    unavailableServiceCount = unavailableServiceCount + 1
                    print("  " + portNumber + " [" + portState + "] -> Service: Unavailable")
                end if
            end for
        else
            devicesWithoutPorts = devicesWithoutPorts + 1
            print("No Ports Reported")
        end if
    else
        unavailablePortScans = unavailablePortScans + 1
        print("Port Scan: Unavailable")
    end if

    print("")
end for

print("========================================")
print("             SCAN SUMMARY")
print("========================================")
print("")
print("[ NETWORK ]")
print("LAN Devices Discovered: " + deviceCount)
print("Devices With Ports: " + devicesWithPorts)
print("Devices Without Ports: " + devicesWithoutPorts)
print("Unavailable Port Scans: " + unavailablePortScans)
print("")
print("[ PORTS ]")
if isRemote == 0 then
    print("Local Active Ports: " + localPortCount)
end if
print("LAN Open Ports: " + openPortCount)
print("LAN Closed Ports: " + closedPortCount)
print("")
print("[ SERVICE IDENTIFICATION ]")
print("Identified Services: " + identifiedServiceCount)
print("Unavailable Services: " + unavailableServiceCount)
print("")
print("[ SERVICE BREAKDOWN ]")
print("HTTP Services: " + httpCount)
print("FTP Services: " + ftpCount)
print("SSH Services: " + sshCount)
print("Other Services: " + otherServiceCount)
print("")
print("========================================")
print("       PING-SCOUT 0.5 COMPLETE")
print("========================================")
